{
  "rewrites": [
    { "source": "/", "destination": "/api/app" },
    { "source": "/app.html", "destination": "/api/app" }
  ],
  "headers": [
    {
      "source": "/content-update.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
